{
  "name": "claude-video",
  "version": "1.0.0",
  "private": true,
  "description": "Dashcam promo — vertical edit (TikTok / IG Reels) in Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "fetch-assets": "bash scripts/fetch-assets.sh",
    "preview": "remotion render src/index.ts DashcamPromo out/preview.mp4 --scale=0.5 --crf=28",
    "render": "remotion render src/index.ts DashcamPromo out/final.mp4 --crf=16"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@remotion/cli": "^4.0.541",
    "@remotion/media-utils": "^4.0.541",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.541"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
